# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Service role — bypasses RLS entirely. Required by the routes that run with no
# user session, because RLS grants writes to `authenticated` only: the inbound
# order webhooks (lib/webhooks/inbound-order.ts) and POST
# /api/daily-message/cron-generate. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o  # optional — defaults to gpt-4o

# ─── Groq AI (optional fallback — not used by default) ─────────────────────────
# GROQ_API_KEY=gsk_your-groq-api-key

# ─── Stripe (optional — for inbound webhook) ───────────────────────────────────
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ─── Inbound Webhook (optional — for Supabase/Zapier webhook) ─────────────────
WEBHOOK_SECRET=your-long-random-secret

# ─── Daily Card Message ───────────────────────────────────────────────────────
# Read secret — gates the public GET /api/daily-message/fetch route that the
# external WhatsApp automation calls for today's approved text.
DAILY_MESSAGE_FETCH_SECRET=your-long-random-secret
# Trigger secret — gates POST /api/daily-message/cron-generate, called by the
# Supabase pg_cron job. Must be a DIFFERENT value from the fetch secret above:
# this one can spend OpenAI tokens and write rows, so a leak of the read-only
# fetch secret must not grant write access. The same value is stored in Supabase
# Vault as 'daily_message_cron_secret' — see
# supabase/migrations/add_daily_message_pg_cron.sql.
DAILY_MESSAGE_CRON_SECRET=your-long-random-secret

# ─── Gmail (optional — for outbound reading emails) ───────────────────────────
# Run GET /api/auth/gmail to start the OAuth flow
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER_ADDRESS=hello@example.com

# ─── Website Sync (optional — for syncing order status back to public site) ───
WEBSITE_SUPABASE_URL=https://your-website-project.supabase.co
WEBSITE_SUPABASE_SERVICE_KEY=your-service-role-key
WEBSITE_ORDERS_TABLE=orders
WEBSITE_STATUS_COLUMN=status
WEBSITE_STATUS_SENT_VALUE=completed
